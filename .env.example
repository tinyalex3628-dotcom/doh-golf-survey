# ── Supabase (필수) ─────────────────────────────────────────
# supabase.com 프로젝트 → Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # 절대 공개 금지!

# 배포된 사이트 주소 (알림톡 링크 만들 때 사용)
NEXT_PUBLIC_SITE_URL=https://내사이트주소.vercel.app

# ── 카카오 알림톡 (선택 — 나중에 준비되면 채우세요) ──────────
# solapi.com 가입 후 발급. 비어 있으면 "링크 복사" 방식으로 동작해요.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=          # 카카오 비즈니스 채널 ID
SOLAPI_TEMPLATE_ID=    # 승인받은 알림톡 템플릿 ID
SOLAPI_SENDER_PHONE=   # 발신 등록된 전화번호

# ── 자막 (선택 — 스튜디오 레슨 영상 자동 자막) ────────────────
# platform.openai.com 에서 발급. 분당 약 8원 수준 (Whisper).
# 비어 있으면 자막 만들기 버튼이 안내 메시지를 띄웁니다.
OPENAI_API_KEY=

# ── 카카오 로그인 (필수) ─────────────────────────────────────
# developers.kakao.com → 앱 설정 → 플랫폼 키 → REST API 키 수정 화면에서 복사
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
